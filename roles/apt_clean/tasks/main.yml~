---
# System hygiene: refresh the package cache and upgrade installed packages to
# the latest WITHIN the current release (NOT a dist/release upgrade). No user
# input -- identical on every node and every deployment, so no requires:.
# Cloud images can be stale; running this before configuration is good practice.
- name: "apt update + upgrade (within-release)"
  ansible.builtin.apt:
    update_cache: yes
    upgrade: yes            # 'yes' = safe upgrade; NOT dist-upgrade
  become: true
  register: _apt_upgrade
# Note: if 'apt upgrade' on a very stale image ever runs long enough to drop the
# SSH connection, add async:/poll: here. Not included by default -- it adds
# complexity and most upgrades complete well within the connection timeout.
