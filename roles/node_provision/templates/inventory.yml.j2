# GENERATED by node_provision -- consolidated inventory (Option A).
# Provision writes this; later runs read it (configure without re-querying cloud).
# Regenerated each provision run. Edit the SPEC, not this file.
#
# Connection is SELF-CONTAINED: each host carries its own connection args and
# key. Ansible never consults ~/.ssh/config.
#   - the BASTION connects directly on its public/floating IP (no proxy).
#   - every other host jumps THROUGH the bastion via ProxyCommand.
#
# Hosts are emitted per role group, but ONLY those that are actual provisioned
# nodes (members of all_provisioned). This keys off the data invariant rather
# than group-name patterns, so any role name works and the control node
# (localhost) is never written.
#
# SSH connection multiplexing (ControlMaster/ControlPersist) is included so that
# many hosts proxying through ONE bastion under Ansible parallelism reuse a
# persistent master connection instead of opening a storm of simultaneous
# bastion logins (which trips the bastion sshd's MaxStartups limit).
all:
  vars:
    ansible_user: {{ deploy_conn.remote_user }}
{% set nocfg = '-F /dev/null ' %}
{% set shk = '' if deploy_conn.strict_host_key_checking | default(false) else '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ' %}
{% set mux = '-o ControlMaster=auto -o ControlPersist=120s -o ServerAliveInterval=15 -o ServerAliveCountInterval=3 ' %}
{% set proxy = '-o ProxyCommand="ssh -W %h:%p -i ' ~ deploy_conn.bastion.key ~ ' ' ~ nocfg ~ shk ~ mux ~ deploy_conn.bastion.user ~ '@' ~ deploy_conn.bastion.host ~ '"' %}
  children:
{% for grp in (groups.keys() | reject('in', ['all','ungrouped','all_provisioned']) | sort) %}
{% set members = groups[grp] | select('in', groups['all_provisioned']) | sort %}
{% if members | length > 0 %}
    {{ grp }}:
      hosts:
{% for h in members %}
{% set is_bastion = h in (groups['bastion'] | default([])) %}
        {{ h }}:
{% if is_bastion %}
          # bastion: reached DIRECTLY on its floating/public IP, no proxy
          ansible_host: {{ hostvars[h].node_floating_ip | default(node_ip_map[h]) | default('NO_IP') }}
          ansible_ssh_private_key_file: {{ hostvars[h].node_ssh_key_file | default(deploy_conn.default_node_key) }}
          ansible_ssh_common_args: '{{ nocfg }}{{ shk }}{{ mux }}'
{% else %}
          ansible_host: {{ node_ip_map[h] | default('NO_IP_CAPTURED') }}
          ansible_ssh_private_key_file: {{ hostvars[h].node_ssh_key_file | default(deploy_conn.default_node_key) }}
          ansible_ssh_common_args: '{{ nocfg }}{{ shk }}{{ mux }}{{ proxy }}'
{% endif %}
          node_cluster: {{ hostvars[h].node_cluster }}
          node_group: {{ hostvars[h].node_group }}
{% endfor %}
{% endif %}
{% endfor %}
