# Delete the kubernetes.list file.
# We use the brute force approach.
  - name: "Remove older version of kubernetes.list file, if any"
    ansible.builtin.file:
      path: /etc/apt/sources.list.d/kubernetes.list  # This is the new location
                                                          # and extension
      state: absent
    become: true # done per task now

# delete any older version of gpg, if we have one.
  - name: "Remove older version of K8s GPG apt key, if any"
    ansible.builtin.file:
      path: /etc/apt/keyrings/kubernetes-apt-keyring.gpg  # This is the new location
                                                          # and extension
      state: absent
    become: true # done per task now

# The following iptables stuff is mentioned at https://kubernetes.io/docs/setup/production-environment/container-runtimes/
#
# This is no longer mentioned in the documentation
# ensure that iptables see bridged traffic
# But I guess it is needed (as students mentioned)
  - name: "Load br_netfilter"
    community.general.modprobe:
      name: br_netfilter
      state: present
    become: true

# This is no longer mentioned in the documentation
      
  - name: "Remove old version of sysctl k8s.conf"
    ansible.builtin.file:
      path: /etc/sysctl.d/k8s.conf
      state: absent
    become: true # done per task now

