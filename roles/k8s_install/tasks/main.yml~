# Set IPv4 forwarding
  - name: "Set IPv4 forwarding"
    ansible.builtin.shell: |
      cat <<EOF | sudo tee /etc/sysctl.d/k8s.conf
      net.ipv4.ip_forward = 1
      EOF
      sysctl --system
    become: true # done per task now

# install pre requisite packages for Kubernetes. Some of these may already be there
# and/or gotten installed when installing Docker
  - name: "Install a variety of pre-reqs for Kubernetes"
    ansible.builtin.apt:
      name: "{{ item }}"
      state: latest
      update_cache: yes    # basically do a apt-get update
    become: true # done per task now
    loop:
      - apt-transport-https
      - ca-certificates
      - curl
      - gpg

# Create the keyrings dir /etc/apt/keyrings. In newer Ubuntu releases
# this directory is supposed to exist by default.
#
# This part is also newer compared to previous years
# This does the step "sudo install -m 0755 -d /etc/apt/keyrings"
  - name: "Create keyrings dir, if not present"
    ansible.builtin.file:
      path: /etc/apt/keyrings
      state: directory  # creates dir if not present else sort of no-op
      mode: '0755'
    become: true # done per task now
      
# This approach creates a kubernetes.sources file which is causing
# lots of problems.
# # Now update the apt sources with this signed gpg key
#   - name: "Add kubernetes signed repo using new approach"
#     ansible.builtin.deb822_repository:
#       name: kubernetes
#       types: deb
#       uris: https://pkgs.k8s.io/core
#       suites: stable:/{{ K8s['version'] }}/deb/
#       signed_by: /etc/apt/keyrings/kubernetes-apt-keyring.gpg
#       state: present  # add the repository
#     become: true

 # Since the apt_key module is deprecated, we have to use a convoluted
 # approach using get_url and running the gpg command
 # via the builtin shell
 # Now add the new gpg key using get_url as apt_key is gone
  - name: "Fetch Kubernetes GPG apt key into temp location"
    ansible.builtin.get_url:
      url: https://pkgs.k8s.io/core:/stable:/{{ K8s['version'] }}/deb/Release.key
      dest: /tmp/k8s.gpg
      force: true  # overwrite prev file
      
  - name: "Run gpg command on downloaded key"
    ansible.builtin.shell:
      cmd: "gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg /tmp/k8s.gpg"
    become: true
      
  - name: "Change permission on gpg file to 0644"
    ansible.builtin.file:
      path: /etc/apt/keyrings/kubernetes-apt-keyring.gpg
      mode: 644
    become: true
      
  - name: "Delete temporarily downloaded gpg key"
    ansible.builtin.file:
      path: /tmp/k8s.gpg
      state: absent
      
# Now add the repository (this has changed over the years)
  - name: "Add kubernetes package repository with signed gpg"
    ansible.builtin.apt_repository:
      repo: "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/{{ K8s['version'] }}/deb/ /"
      state: present
      filename: kubernetes
    become: true # done per task now

# now install Kubernetes
  - name: "Now install Kubernetes"
    ansible.builtin.apt:
      name: "{{ item }}"
      state: present
      update_cache: yes
    become: true # done per task now
    loop:
      - kubeadm
      - kubelet
      - kubectl
      # - kubernetes-cni  # it is said that this is subsumed by the above

# the web site suggests holding the packages to this version
  - name: "Hold packages to the current versions"
    ansible.builtin.dpkg_selections:
      name: "{{ item }}"
      selection: hold
    become: true # done per task now
    loop:
      - kubeadm
      - kubelet
      - kubectl

# install kubernetes python package
  - name: "Install kubernetes package via pip3"
    pip:
      name: "{{ item }}"
      state: latest
      virtualenv: "{{ python['venv'] }}"  # will create if it does not exist
      virtualenv_site_packages: true # inherit packages from global site
      # presumably the latest pip3 gets installed in /usr/local and not the /usr/bin
      # executable: /usr/local/bin/pip3  # this forces to use pip3
      # there were issues showing up with PyYAML coming in the way. Hence this
      # other nonsensical hack
      # extra_args:  --ignore-installed PyYAML
    loop:    # in the other file we used loop (which is the newer approach)
      - kubernetes
...
