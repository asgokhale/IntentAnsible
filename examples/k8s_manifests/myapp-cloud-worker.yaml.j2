# Google AI helped convert the docker compose to this YAML, which 
# we have further modified as deemed fit.

# ==============================================================================
# 1. CLOUD-WORKER Deployment
# ==============================================================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloud-worker  # name of this deployment
spec:
  replicas: 1   # for now. When it works, we will make it more.
  selector:
    matchLabels:
      app: cloud-worker  # used by the service to match with the pod
  minReadySeconds: 5  # if anything crashes before 5 secs, the deployment is not
                      # considered as ready and available. Default value is 0
  template:
    metadata:
      labels:
        app: cloud-worker
    spec:
      restartPolicy: Always  # always restart on failure
      containers:
        - name: cloud-worker
          image: {{ registry_endpoint }}/myapp/src-cloud-worker:latest # Point to your built Docker image
          imagePullPolicy: Always
          command: ["python"]
          args: ["core/cloudworker.py"]
          resources:
            requests:
              memory: "2Gi"     # Assures the pod only schedules on a node with 2GB free
              cpu: "1"          # Claims 1 of your 2 available vCPUs
            limits:
              memory: "3276Mi"  # HARD CEILING: Leaving ~600MB completely safe for
                                # the KVM OS (needs integer and so converted to Mi)
              cpu: "2"          # Allows bursting to use both vCPUs
          readinessProbe:  # used to determine if pod is busy or idle
            exec:
              command:
                - ls
                - /tmp/ready
            initialDelaySeconds: 5
            periodSeconds: 1   # check every one second
            successThreshold: 1
            failureThreshold: 1 # take the file down
          ports:
            - containerPort: 5555  # runs on port 5555 internally
                               # we also advertise 5555 in the Cluster service
# Not sure if we need this because our mounted volume is writable
#        securityContext:
#          runAsUser: 0 # Matches user: "root" from Docker Compose
          env:
            - name: PYTHONPATH  # was needed for finding the package
              value: "/"
            - name: APP_DEPLOYMENT  # not sure if needed for worker
              value: "k8s"
            - name: APP_WORKER_POOLSIZE  # likewise, not sure needed here
              value: "1"
          volumeMounts:
            - name: db-volume
              mountPath: /server/flask/database
            - name: users-volume
              mountPath: /server/core/users
      volumes:
        - name: db-volume
          persistentVolumeClaim:
            claimName: myapp-db-pvc
        - name: users-volume
          persistentVolumeClaim:
            claimName: myapp-users-pvc
